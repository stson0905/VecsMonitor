<Window x:Class="HecsMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HecsMonitor.Controls"
        xmlns:v="clr-namespace:HecsMonitor.Views"
        xmlns:cv="clr-namespace:HecsMonitor.Converters"
        xmlns:b="clr-namespace:HecsMonitor.Converters"
        Title="{b:Brand 'HECS Monitor'}" Width="1640" Height="960" MinWidth="1120" MinHeight="720"
        Icon="/Assets/HecsMonitor.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 라이브 표시 점 깜빡임 -->
        <Style x:Key="PulseDot" TargetType="Ellipse">
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 채널 카드 =====
             카드 구성은 고정이고, 페이지 칸에 맞춰 Viewbox로 카드 전체를 같은 비율로 확대·축소한다. -->
        <DataTemplate x:Key="ChannelCard">
            <Viewbox Margin="0,0,14,14" Stretch="Uniform">
            <Border Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    CornerRadius="16" Background="{StaticResource SurfaceBrush}" BorderThickness="1"
                    Cursor="Hand" ToolTip="{b:Brand '클릭: 원본 ↔ HECS 비교 화면'}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource LineHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Offline">
                                <Setter Property="BorderBrush" Value="#88F43F5E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Alarm">
                                <Setter Property="BorderBrush" Value="{StaticResource AlarmBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Disabled">
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- 헤더 -->
                    <Grid Margin="14,12,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Fill="{Binding StatusKind, Converter={StaticResource KindBrush}}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Group}">
                                <Run Text="▶ "/><Run Text="{Binding HecsEndpoint, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding StatusText, Mode=OneWay}"
                                     Foreground="{Binding StatusKind, Converter={StaticResource KindBrush}}"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="9" Padding="10,3,10,4" VerticalAlignment="Center"
                                Background="{StaticResource AccentGrad}" ToolTip="{b:Brand '실시간 압축률 (원본 : HECS)'}">
                            <TextBlock Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource NumFont}">
                                <Run Text="{Binding RatioText, Mode=OneWay}" FontSize="17" FontWeight="Bold"/><Run Text=" : 1" FontSize="11" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- HECS 실시간 썸네일 -->
                    <Grid Margin="10,0" Height="{Binding DataContext.ThumbHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Rectangle RadiusX="10" RadiusY="10" Fill="#05080B"/>
                        <Rectangle RadiusX="10" RadiusY="10" Visibility="{Binding HasVideo, Converter={StaticResource BoolVis}}">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasVideo, Converter={StaticResource InvBoolVis}}">
                            <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center"
                                       Foreground="{StaticResource FaintBrush}"/>
                            <TextBlock Text="{Binding VideoPlaceholderText}" Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="6"
                                Background="#B3000000" Padding="7,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AlarmBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Style="{StaticResource PulseDot}" Visibility="{Binding HasVideo, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{b:Brand 'HECS'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource HecsBrush}"/>
                                <TextBlock Text=" OUT" FontSize="10.5" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
                            </StackPanel>
                        </Border>
                        <Border VerticalAlignment="Bottom" CornerRadius="0,0,10,10" Padding="10,14,10,7"
                                Visibility="{Binding HasVideo, Converter={StaticResource BoolVis}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#AA000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding HecsVideoInfo}" FontSize="11" Foreground="#DDFFFFFF"/>
                        </Border>
                    </Grid>

                    <!-- 원본 vs HECS 비트레이트 막대 + 절감률 링 -->
                    <Grid Margin="14,12,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Num}" FontSize="13.5" Text="{Binding OrigRateText}"/>
                                <Ellipse Width="6" Height="6" Fill="{StaticResource OrigBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="원본 카메라">
                                    <Run Text="INPUT " FontWeight="SemiBold" Foreground="{StaticResource OrigBrush}"/><Run Text="{Binding InputResFps, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                            <Border Height="5" CornerRadius="3" Background="#14FFFFFF" Margin="0,5,0,9">
                                <Border CornerRadius="3" Background="{StaticResource OrigBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding OrigFraction}"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Num}" FontSize="13.5" Text="{Binding HecsRateText}"
                                           Foreground="{StaticResource HecsBrush}"/>
                                <Ellipse Width="6" Height="6" Fill="{StaticResource HecsBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FpsDropText}">
                                    <Run Text="OUTPUT " FontWeight="SemiBold" Foreground="{StaticResource HecsBrush}"/><Run Text="{Binding OutputResFps, Mode=OneWay}"
                                         Foreground="{Binding OutputFpsKind, Mode=OneWay, Converter={StaticResource KindBrush}}"/>
                                </TextBlock>
                            </DockPanel>
                            <Border Height="5" CornerRadius="3" Background="#14FFFFFF" Margin="0,5,0,0">
                                <Border CornerRadius="3" Background="{StaticResource HecsBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding HecsFraction}"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="66" Height="66" Margin="16,0,0,0" ToolTip="대역폭 절감률">
                            <c:RingGauge Value="{Binding SavingFraction}" Thickness="6" ValueBrush="{StaticResource SaveGrad}"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Num}" FontWeight="SemiBold">
                                    <Run Text="{Binding SavingText, Mode=OneWay}" FontSize="17"/><Run Text="%" FontSize="10"/>
                                </TextBlock>
                                <TextBlock Text="절감" FontSize="9.5" HorizontalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 최근 60초 추이 -->
                    <c:DualSeriesChart Height="44" Margin="12,6,12,4" Capacity="60"
                                       SeriesA="{Binding OrigHistory}" SeriesB="{Binding HecsHistory}" Version="{Binding HistoryVersion}"
                                       BrushA="{StaticResource OrigBrush}" BrushB="{StaticResource HecsBrush}"/>
                    <DockPanel Margin="14,2,14,12">
                        <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource SaveBrush}">
                            <Run Text="절약 "/><Run Text="{Binding SavedText, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{StaticResource FaintBrush}">
                            <Run Text="평균 "/><Run Text="{Binding AvgRatioText, Mode=OneWay}"/><Run Text=":1  ·  60초 추이"/>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>
            </Viewbox>
        </DataTemplate>

        <!-- ===== 마지막 페이지의 빈 칸 (채널 카드와 같은 크기) ===== -->
        <DataTemplate x:Key="EmptySlotCard">
            <Viewbox Margin="0,0,14,14" Stretch="Uniform">
            <Grid Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                  Height="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                <Rectangle x:Name="frame" RadiusX="16" RadiusY="16" Stroke="#2A3646" StrokeThickness="1.5" StrokeDashArray="5 4"
                           Fill="#05FFFFFF" Opacity="0.45"/>
                <Button x:Name="add" Visibility="Collapsed" Cursor="Hand" ToolTip="새 채널을 등록합니다"
                        Command="{Binding DataContext.AddChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent" CornerRadius="16">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="plus" Width="44" Height="44" CornerRadius="22" Background="#1422D3EE" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource HecsBrush}"/>
                                    </Border>
                                    <TextBlock Text="채널 추가" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,2"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource FaintBrush}" FontFamily="{StaticResource NumFont}">
                                        <Run Text="등록 "/><Run Text="{Binding AddText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#0A22D3EE"/>
                                    <Setter TargetName="plus" Property="Background" Value="#2A22D3EE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            </Viewbox>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAdd}" Value="True">
                    <Setter TargetName="add" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="frame" Property="Opacity" Value="1"/>
                    <Setter TargetName="frame" Property="Stroke" Value="#3A4A5E"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <cv:SlotTemplateSelector x:Key="SlotSelector" ChannelTemplate="{StaticResource ChannelCard}" EmptyTemplate="{StaticResource EmptySlotCard}"/>

        <!-- ===== 페이지 독 버튼: 페이지 배치 모양 그대로의 상태 미니맵 ===== -->
        <DataTemplate x:Key="PagePill">
            <Button Command="{Binding DataContext.GoPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" ToolTip="{Binding ToolTip}" Cursor="Hand" Focusable="False" Margin="3,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="b" CornerRadius="8" Padding="7,5,8,5" Background="#08FFFFFF"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="num" Text="{Binding Label}" FontFamily="{StaticResource NumFont}" FontSize="11.5"
                                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="8"/>
                                    <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Rows="{Binding DataContext.GridRows, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle x:Name="dot" Width="6" Height="4" Margin="0.75" RadiusX="1" RadiusY="1"
                                                           Fill="{Binding StatusKind, Converter={StaticResource KindBrush}}"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Empty">
                                                        <Setter TargetName="dot" Property="Opacity" Value="0.25"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- 자동 넘김 진행 막대 -->
                            <Border x:Name="progress" Height="2" CornerRadius="1" Margin="8,0,8,1" VerticalAlignment="Bottom"
                                    Background="{StaticResource AccentGrad}" RenderTransformOrigin="0,0.5" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding DataContext.TourProgress, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Border.RenderTransform>
                            </Border>
                            <!-- 이 페이지에 경보 채널이 있음 -->
                            <Ellipse x:Name="alarm" Width="8" Height="8" Margin="0,-3,-3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Fill="{StaticResource AlarmBrush}" Stroke="{StaticResource BgBrush}" StrokeThickness="1.5"
                                     Style="{StaticResource PulseDot}" Visibility="{Binding HasAlarm, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineHoverBrush}"/>
                                <Setter TargetName="num" Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#99F43F5E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1C22D3EE"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource HecsBrush}"/>
                                <Setter TargetName="num" Property="Foreground" Value="{StaticResource HecsBrush}"/>
                                <Setter TargetName="num" Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCurrent}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.IsTourOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="progress" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- ===== 리스트 보기 (HECS 장비 카메라 목록과 같은 정보 배치) ===== -->
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CommandParameter" Value="{Binding}"/>
        </Style>
        <DataTemplate x:Key="ChannelRow">
            <Border Margin="0,0,0,8" CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderThickness="1" Padding="10,10,8,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource LineHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Offline">
                                <Setter Property="BorderBrush" Value="#88F43F5E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Alarm">
                                <Setter Property="BorderBrush" Value="{StaticResource AlarmBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Disabled">
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition MinWidth="330"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 썸네일 (클릭 → 비교 화면) -->
                    <Grid Width="160" Height="90" Cursor="Hand" ToolTip="{b:Brand '클릭: 원본 ↔ HECS 비교 화면'}">
                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                        </Grid.InputBindings>
                        <Rectangle RadiusX="8" RadiusY="8" Fill="#05080B"/>
                        <Rectangle RadiusX="8" RadiusY="8" Visibility="{Binding HasVideo, Converter={StaticResource BoolVis}}">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Text="{Binding VideoPlaceholderText}" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasVideo, Converter={StaticResource InvBoolVis}}"/>
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AlarmBrush}" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Style="{StaticResource PulseDot}" Visibility="{Binding HasVideo, Converter={StaticResource BoolVis}}"/>
                    </Grid>

                    <!-- 절감률 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Style="{StaticResource Num}" Foreground="{StaticResource SaveGrad}">
                            <Run Text="{Binding SavingText, Mode=OneWay}" FontSize="30" FontWeight="SemiBold"/><Run Text="%" FontSize="15"/>
                        </TextBlock>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="1,-2,0,0">
                            <Run Text="절감 · "/><Run Text="{Binding RatioText, Mode=OneWay}" Foreground="{StaticResource HecsBrush}" FontWeight="SemiBold"/><Run Text=":1"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- 이름 / HECS 주소 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding StatusKind, Converter={StaticResource KindBrush}}"/>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="16,4,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="▶ "/><Run Text="{Binding HecsEndpoint, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="16,2,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Group, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding StatusText, Mode=OneWay}"
                                 Foreground="{Binding StatusKind, Converter={StaticResource KindBrush}}"/>
                        </TextBlock>
                        <Border Margin="16,5,0,0" HorizontalAlignment="Left" CornerRadius="5" Background="#22FBBF24" Padding="6,1"
                                Visibility="{Binding FpsDrop, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding FpsDropText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- INPUT / OUTPUT -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,18,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OrigRateText}" Style="{StaticResource Num}" FontSize="14"/>
                            <TextBlock Text="INPUT" Width="62" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource OrigBrush}"/>
                            <TextBlock Text="{Binding InputResFps}" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border Height="4" CornerRadius="2" Background="#14FFFFFF" Margin="62,5,0,8">
                            <Border CornerRadius="2" Background="{StaticResource OrigBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding OrigFraction}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding HecsRateText}" Style="{StaticResource Num}" FontSize="14" Foreground="{StaticResource HecsBrush}"/>
                            <TextBlock Text="OUTPUT" Width="62" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource HecsBrush}"/>
                            <TextBlock FontSize="12.5" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" Text="{Binding OutputResFps}"
                                       Foreground="{Binding OutputFpsKind, Converter={StaticResource KindBrush}}" ToolTip="{Binding FpsDropText}"/>
                        </DockPanel>
                        <Border Height="4" CornerRadius="2" Background="#14FFFFFF" Margin="62,5,0,0">
                            <Border CornerRadius="2" Background="{StaticResource HecsBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding HecsFraction}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>

                    <!-- 60초 추이 -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <c:DualSeriesChart Height="52" Capacity="60"
                                           SeriesA="{Binding OrigHistory}" SeriesB="{Binding HecsHistory}" Version="{Binding HistoryVersion}"
                                           BrushA="{StaticResource OrigBrush}" BrushB="{StaticResource HecsBrush}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource SaveBrush}" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Run Text="절약 "/><Run Text="{Binding SavedText, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- 작업 -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button Style="{StaticResource RowAction}" Content="&#xE8A7;" ToolTip="{b:Brand '원본 ↔ HECS 비교'}"
                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Style="{StaticResource RowAction}" Content="&#xE72C;" ToolTip="재연결"
                                Command="{Binding DataContext.ReconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Style="{StaticResource RowAction}" Content="&#xE70F;" ToolTip="채널 설정"
                                Command="{Binding DataContext.EditChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Style="{StaticResource RowAction}" Content="&#xE8C8;" ToolTip="복제"
                                Command="{Binding DataContext.DuplicateChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Style="{StaticResource RowAction}" Content="&#xE74D;" ToolTip="삭제"
                                Command="{Binding DataContext.DeleteChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 비교 화면 통계 표 한 줄 -->
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Num}">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ===== 내비게이션 레일 ===== -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Image DockPanel.Dock="Top" Source="/Assets/HecsMonitor.png" Width="42" Height="42" Margin="0,13,0,21"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{b:Brand 'HECS Live Compression Monitor'}"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BD;" Width="46" Height="46" FontSize="17"
                            ToolTip="이벤트 패널 표시/숨기기" Command="{Binding ToggleEventsCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" Width="46" Height="46" FontSize="17"
                            ToolTip="기록 폴더 열기" Command="{Binding OpenLogFolderCommand}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <RadioButton Style="{StaticResource NavItem}" Content="&#xE80F;" ToolTip="대시보드" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=dashboard}"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="&#xE713;" ToolTip="설정" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=settings}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- ===== 타이틀 바 ===== -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize"/>
                    <Button Style="{StaticResource CaptionButton}" x:Name="MaxButton" Content="&#xE922;" Click="OnMaximize"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=dashboard}">
                    <Grid Width="230" Margin="0,0,12,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="채널 · 그룹 검색"
                                 Padding="32,6,10,6" FontSize="12.5"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="12,0,0,0" FontSize="12"
                                   Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False"/>
                    </Grid>
                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Padding="10,4" GroupName="view" ToolTip="카드 보기"
                                         Content="&#xF0E2;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=card}"/>
                            <RadioButton Style="{StaticResource Segment}" Padding="10,4" GroupName="view" ToolTip="리스트 보기"
                                         Content="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=list}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,0"
                            Visibility="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=card}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Padding="10,4" Content="S" GroupName="card"
                                         ToolTip="작게 · 한 화면 12채널 (64채널 = 6쪽)"
                                         IsChecked="{Binding CardSize, Converter={StaticResource Eq}, ConverterParameter=S}"/>
                            <RadioButton Style="{StaticResource Segment}" Padding="10,4" Content="M" GroupName="card"
                                         ToolTip="보통 · 한 화면 8채널 (64채널 = 8쪽)"
                                         IsChecked="{Binding CardSize, Converter={StaticResource Eq}, ConverterParameter=M}"/>
                            <RadioButton Style="{StaticResource Segment}" Padding="10,4" Content="L" GroupName="card"
                                         ToolTip="크게 · 한 화면 6채널 (64채널 = 11쪽)"
                                         IsChecked="{Binding CardSize, Converter={StaticResource Eq}, ConverterParameter=L}"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="전체 재연결" Command="{Binding ReconnectAllCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="압축 효율 보고서 내보내기 (CSV)" Command="{Binding ExportReportCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE774;" ToolTip="{b:Brand 'HECS 장비 웹 콘솔 열기'}" Command="{Binding OpenConsoleCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="12,6" Command="{Binding AddChannelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0"/>
                            <TextBlock Text="채널 추가" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock Text="{b:Brand 'HECS'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HecsBrush}"/>
                    <TextBlock Text=" Live Compression Monitor" FontSize="16" FontWeight="SemiBold"/>
                    <Border Margin="14,0,0,0" CornerRadius="6" Background="#14FFFFFF" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource NumFont}" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- ===== 대시보드 ===== -->
            <Grid Grid.Row="1" Visibility="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=dashboard}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- 히어로: 전체 절감 현황 -->
                <Border Margin="20,4,20,16" CornerRadius="20" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid>
                    <Border CornerRadius="20" Background="{StaticResource HeroGlow}" Padding="26,20"
                            Visibility="{Binding HeroCollapsed, Converter={StaticResource InvBoolVis}}">
                        <Grid Height="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" MinWidth="250">
                                <TextBlock Text="실시간 대역폭 절감률" Style="{StaticResource Caption}" FontSize="13"/>
                                <TextBlock Style="{StaticResource Num}" Foreground="{StaticResource SaveGrad}" Margin="0,-4,0,0">
                                    <Run Text="{Binding SavingPctText, Mode=OneWay}" FontSize="68" FontWeight="SemiBold"/><Run Text="%" FontSize="30"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,-2,0,0">
                                    <Border CornerRadius="7" Background="#1A22D3EE" Padding="9,3">
                                        <TextBlock FontFamily="{StaticResource NumFont}" Foreground="{StaticResource HecsBrush}" FontSize="14">
                                            <Run Text="압축률 "/><Run Text="{Binding TotalRatioText, Mode=OneWay}" FontWeight="Bold"/><Run Text=" : 1"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}">
                                        <Run Text="−"/><Run Text="{Binding SavedBandwidthText, Mode=OneWay}"/><Run Text=" 절감 중"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- 원본 → HECS 흐름 -->
                            <Grid Grid.Column="1" Margin="34,0,30,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource OrigBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Text="원본 카메라 합계" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Num}">
                                        <Run Text="{Binding TotalOrigValue, Mode=OneWay}" FontSize="28"/><Run Text=" "/><Run Text="{Binding TotalOrigUnit, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SubTextBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,2">
                                    <TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource FaintBrush}"/>
                                    <Border CornerRadius="5" Background="{StaticResource AccentGrad}" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="{b:Brand 'HECS 압축'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource HecsBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{b:Brand 'HECS 출력 합계'}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Num}" Foreground="{StaticResource HecsBrush}">
                                        <Run Text="{Binding TotalHecsValue, Mode=OneWay}" FontSize="28"/><Run Text=" "/><Run Text="{Binding TotalHecsUnit, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SubTextBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- 전체 대역폭 추이 -->
                            <Border Grid.Column="2" Background="#0A000000" CornerRadius="14" Padding="10,8,14,6">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="52,0,0,2">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource OrigBrush}" Margin="0,0,5,0"/>
                                            <TextBlock Text="원본" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,12,0"/>
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource HecsBrush}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{b:Brand 'HECS'}" Style="{StaticResource Caption}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5">
                                            <Run Text="전체 대역폭 추이 · "/><Run Text="{Binding HistoryLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <c:DualSeriesChart ShowAxis="True" Capacity="{Binding HistoryCapacity}"
                                                       SeriesA="{Binding TotalOrigHistory}" SeriesB="{Binding TotalHecsHistory}"
                                                       Version="{Binding TotalHistoryVersion}"
                                                       BrushA="{StaticResource OrigBrush}" BrushB="{StaticResource HecsBrush}"/>
                                </DockPanel>
                            </Border>

                            <!-- 누적/상태 -->
                            <Grid Grid.Column="3" Margin="28,0,0,0" Width="200" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="누적 절약 데이터" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding TotalSavedText}" Style="{StaticResource Num}" FontSize="28" Foreground="{StaticResource SaveBrush}"/>
                                </StackPanel>
                                <UniformGrid Grid.Row="2" Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="가동" Style="{StaticResource Overline}"/>
                                        <TextBlock Text="{Binding OnlineText}" Style="{StaticResource Num}" FontSize="15"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="경보" Style="{StaticResource Overline}"/>
                                        <TextBlock Text="{Binding AlarmCount}" FontSize="15">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Num}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AlarmBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="가동 시간" Style="{StaticResource Overline}"/>
                                        <TextBlock Text="{Binding UptimeText}" Style="{StaticResource Num}" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 접힌 요약: 한 줄 -->
                    <Border CornerRadius="20" Background="{StaticResource HeroGlow}" Padding="22,8,52,8"
                            Visibility="{Binding HeroCollapsed, Converter={StaticResource BoolVis}}">
                        <DockPanel Height="40">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Num}" Foreground="{StaticResource SaveGrad}" VerticalAlignment="Center">
                                    <Run Text="{Binding SavingPctText, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/><Run Text="%" FontSize="14"/>
                                </TextBlock>
                                <TextBlock Text="절감" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,4,14,0"/>
                                <Border CornerRadius="7" Background="#1A22D3EE" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource NumFont}" Foreground="{StaticResource HecsBrush}" FontSize="13">
                                        <Run Text="{Binding TotalRatioText, Mode=OneWay}" FontWeight="Bold"/><Run Text=" : 1"/>
                                    </TextBlock>
                                </Border>
                                <Rectangle Width="1" Height="22" Fill="{StaticResource LineBrush}" Margin="18,0"/>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource OrigBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Num}" VerticalAlignment="Center">
                                    <Run Text="{Binding TotalOrigValue, Mode=OneWay}" FontSize="17"/><Run Text=" "/><Run Text="{Binding TotalOrigUnit, Mode=OneWay}" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                                </TextBlock>
                                <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="10,0"/>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource HecsBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Num}" Foreground="{StaticResource HecsBrush}" VerticalAlignment="Center">
                                    <Run Text="{Binding TotalHecsValue, Mode=OneWay}" FontSize="17"/><Run Text=" "/><Run Text="{Binding TotalHecsUnit, Mode=OneWay}" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                                </TextBlock>
                                <Rectangle Width="1" Height="22" Fill="{StaticResource LineBrush}" Margin="18,0"/>
                                <TextBlock Text="누적 절약 " Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalSavedText}" Style="{StaticResource Num}" FontSize="15" Foreground="{StaticResource SaveBrush}" VerticalAlignment="Center"/>
                                <Rectangle Width="1" Height="22" Fill="{StaticResource LineBrush}" Margin="18,0"/>
                                <TextBlock Text="가동 " Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OnlineText}" Style="{StaticResource Num}" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="경보 " Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                <TextBlock Text="{Binding AlarmCount}" FontSize="14" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Num}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AlarmBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <!-- 남는 폭은 전체 대역폭 추이 -->
                            <c:DualSeriesChart Margin="24,2,0,2" Capacity="{Binding HistoryCapacity}"
                                               SeriesA="{Binding TotalOrigHistory}" SeriesB="{Binding TotalHecsHistory}"
                                               Version="{Binding TotalHistoryVersion}"
                                               BrushA="{StaticResource OrigBrush}" BrushB="{StaticResource HecsBrush}"
                                               ToolTip="{Binding HistoryLabel}"/>
                        </DockPanel>
                    </Border>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" FontSize="11"
                            Command="{Binding ToggleHeroCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Margin" Value="0,8,8,0"/>
                                <Setter Property="Content" Value="&#xE70E;"/>
                                <Setter Property="ToolTip" Value="요약 접기 · 카드를 더 크게 보기"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeroCollapsed}" Value="True">
                                        <Setter Property="Content" Value="&#xE70D;"/>
                                        <Setter Property="ToolTip" Value="요약 펼치기"/>
                                        <Setter Property="Margin" Value="0,13,10,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    </Grid>
                </Border>

                <!-- 채널 카드 + 이벤트 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 카드 보기: 한 페이지 = 카드 크기별 고정 개수 (S 12 · M 8 · L 6) -->
                    <Grid Margin="20,0,6,0" Visibility="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=card}">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="CardHost" Background="Transparent" ClipToBounds="True"
                              SizeChanged="OnCardHostSizeChanged" PreviewMouseWheel="OnCardHostWheel"
                              MouseEnter="OnCardHostMouseEnter" MouseLeave="OnCardHostMouseLeave">
                            <ItemsControl x:Name="CardItems" ItemsSource="{Binding PageItems}" ItemTemplateSelector="{StaticResource SlotSelector}">
                                <ItemsControl.RenderTransform>
                                    <TranslateTransform x:Name="CardSlide"/>
                                </ItemsControl.RenderTransform>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding GridColumns}" Rows="{Binding GridRows}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="검색 결과가 없습니다" Style="{StaticResource Caption}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoSearchResult, Converter={StaticResource BoolVis}}"/>
                        </Grid>

                        <!-- 페이지 독 -->
                        <Grid Grid.Row="1" Margin="0,0,14,14" Height="38"
                              Visibility="{Binding HasNoChannels, Converter={StaticResource InvBoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Num}" VerticalAlignment="Center">
                                    <Run Text="{Binding PageText, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11.5" VerticalAlignment="Center" Margin="10,1,0,0">
                                    <Run Text="{Binding PageRangeText, Mode=OneWay}"/><Run Text="번 채널"/>
                                </TextBlock>
                                <Border CornerRadius="6" Background="#10FFFFFF" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                        ToolTip="등록 채널 / 최대 채널">
                                    <TextBlock FontSize="11" Foreground="{StaticResource SubTextBrush}">
                                        <Run Text="채널 "/><Run Text="{Binding ChannelCountText, Mode=OneWay}" FontFamily="{StaticResource NumFont}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasPages, Converter={StaticResource BoolVis}}">
                                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="30" Height="30" FontSize="11"
                                        ToolTip="이전 페이지 (PgUp · ←)" Command="{Binding PrevPageCommand}"/>
                                <ItemsControl ItemsSource="{Binding Pages}" ItemTemplate="{StaticResource PagePill}" VerticalAlignment="Center" Margin="4,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="30" Height="30" FontSize="11"
                                        ToolTip="다음 페이지 (PgDn · →)" Command="{Binding NextPageCommand}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasPages, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="일시정지" FontSize="11" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           ToolTip="카드 위에 마우스가 있거나 비교 화면이 열려 있으면 자동 넘김을 멈춥니다"
                                           Visibility="{Binding IsTourPaused, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="&#xE8EE;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,0,6,0"
                                           ToolTip="페이지 자동 넘김"/>
                                <Border Style="{StaticResource SegmentHost}" Padding="2" ToolTip="페이지 자동 넘김 (관제 화면 순환)">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Padding="8,3" FontSize="11.5" Content="끔" GroupName="tour"
                                                     IsChecked="{Binding PageTourSec, Converter={StaticResource Eq}, ConverterParameter=0}"/>
                                        <RadioButton Style="{StaticResource Segment}" Padding="8,3" FontSize="11.5" Content="10초" GroupName="tour"
                                                     IsChecked="{Binding PageTourSec, Converter={StaticResource Eq}, ConverterParameter=10}"/>
                                        <RadioButton Style="{StaticResource Segment}" Padding="8,3" FontSize="11.5" Content="30초" GroupName="tour"
                                                     IsChecked="{Binding PageTourSec, Converter={StaticResource Eq}, ConverterParameter=30}"/>
                                        <RadioButton Style="{StaticResource Segment}" Padding="8,3" FontSize="11.5" Content="60초" GroupName="tour"
                                                     IsChecked="{Binding PageTourSec, Converter={StaticResource Eq}, ConverterParameter=60}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <DockPanel Margin="20,0,16,0" Visibility="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=list}">
                        <!-- 열 머리글 -->
                        <Grid DockPanel.Dock="Top" Margin="11,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition MinWidth="330"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="184"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{b:Brand 'HECS 출력 영상'}" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="1" Text="절감률 · 압축률" Style="{StaticResource Overline}" Margin="18,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{b:Brand '이름 · HECS 주소'}" Style="{StaticResource Overline}" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="INPUT / OUTPUT  (해상도 @ fps · 비트레이트)" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="4" Text="최근 60초" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="5" Text="작업" Style="{StaticResource Overline}" Margin="14,0,0,0"/>
                        </Grid>
                        <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListItems" ItemsSource="{Binding ChannelsView}" ItemTemplate="{StaticResource ChannelRow}"/>
                        </ScrollViewer>
                    </DockPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasNoChannels, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource FaintBrush}"/>
                        <TextBlock Text="등록된 채널이 없습니다" FontSize="16" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                        <TextBlock Text="{b:Brand '원본 카메라 RTSP와 HECS 출력 RTSP를 한 쌍으로 등록하세요.'}" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="채널 추가하기" Margin="0,16,0,0" HorizontalAlignment="Center"
                                Command="{Binding EditChannelCommand}"/>
                    </StackPanel>

                    <!-- 이벤트 패널 -->
                    <Border Grid.Column="1" Width="320" Margin="0,0,20,20" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Visibility="{Binding ShowEventPanel, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,8,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="13"
                                        ToolTip="목록 비우기" Command="{Binding ClearEventsCommand}"/>
                                <TextBlock Text="이벤트" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border CornerRadius="8" Background="#14FFFFFF" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Events.Count}" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                                </Border>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Events}" Background="Transparent" BorderThickness="0" Padding="8,0,4,8"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,6,6,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="3" CornerRadius="2" Margin="0,2,10,2"
                                                    Background="{Binding Level, Converter={StaticResource KindBrush}}"/>
                                            <StackPanel Grid.Column="1">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontFamily="{StaticResource NumFont}"
                                                               FontSize="11" Foreground="{StaticResource FaintBrush}"/>
                                                    <TextBlock Text="{Binding Channel}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== 설정 ===== -->
            <v:SettingsView Grid.Row="1" DataContext="{Binding Editor}"
                            Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Eq}, ConverterParameter=settings}"/>
        </Grid>

        <!-- ===== 원본 ↔ HECS 비교 (상세) ===== -->
        <Grid Grid.ColumnSpan="2" Background="#D9040609"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolVis}}">
            <Border Margin="36,60,36,32" CornerRadius="20" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" DataContext="{Binding}">
                <Grid Margin="24,18,24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- 헤더 -->
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="와이프 비교" GroupName="cmp"
                                                 IsChecked="{Binding CompareMode, Converter={StaticResource Eq}, ConverterParameter=wipe}"/>
                                    <RadioButton Style="{StaticResource Segment}" Content="나란히 보기" GroupName="cmp"
                                                 IsChecked="{Binding CompareMode, Converter={StaticResource Eq}, ConverterParameter=side}"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding ReconnectCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                    <TextBlock Text="재연결"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,12,0" Command="{Binding EditChannelCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                    <TextBlock Text="채널 설정"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="닫기 (Esc)" Command="{Binding CloseDetailCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,12,0" Fill="{Binding SelectedChannel.StatusKind, Converter={StaticResource KindBrush}}"/>
                            <TextBlock Text="{Binding SelectedChannel.Name}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}">
                                <Run Text="{Binding SelectedChannel.Group, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SelectedChannel.StatusText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="190"/>
                        </Grid.RowDefinitions>

                        <!-- 영상 비교 -->
                        <Grid x:Name="CompareHost" Margin="0,0,20,0" ClipToBounds="True" SizeChanged="OnCompareSizeChanged">
                            <Rectangle Fill="#05080B" RadiusX="12" RadiusY="12"/>

                            <!-- 와이프 -->
                            <Grid Visibility="{Binding CompareMode, Converter={StaticResource Eq}, ConverterParameter=wipe}">
                                <Image x:Name="WipeOrig" Source="{Binding DetailOrigBitmap}" Stretch="Uniform"/>
                                <Image x:Name="WipeHecs" Source="{Binding DetailHecsBitmap}" Stretch="Uniform"/>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" CornerRadius="7" Background="#C0000000" Padding="10,5">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OrigBrush}">
                                        <Run Text="◀ 원본  "/><Run Text="{Binding SelectedChannel.OrigRateText, Mode=OneWay}" Foreground="White"/>
                                    </TextBlock>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" CornerRadius="7" Background="#C0000000" Padding="10,5">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HecsBrush}">
                                        <Run Text="{Binding SelectedChannel.HecsRateText, Mode=OneWay}" Foreground="White"/><Run Text="{b:Brand '  HECS ▶'}"/>
                                    </TextBlock>
                                </Border>
                                <Slider x:Name="Wipe" Style="{StaticResource WipeSlider}" Value="0.5" ValueChanged="OnWipeChanged"/>
                            </Grid>

                            <!-- 나란히 -->
                            <UniformGrid Columns="2" Visibility="{Binding CompareMode, Converter={StaticResource Eq}, ConverterParameter=side}">
                                <Grid Margin="0,0,4,0">
                                    <Image Source="{Binding DetailOrigBitmap}" Stretch="Uniform"/>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" CornerRadius="7" Background="#C0000000" Padding="10,5">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OrigBrush}">
                                            <Run Text="원본  "/><Run Text="{Binding SelectedChannel.OrigRateText, Mode=OneWay}" Foreground="White"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <Grid Margin="4,0,0,0">
                                    <Image Source="{Binding DetailHecsBitmap}" Stretch="Uniform"/>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" CornerRadius="7" Background="#C0000000" Padding="10,5">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HecsBrush}">
                                            <Run Text="{b:Brand 'HECS  '}"/><Run Text="{Binding SelectedChannel.HecsRateText, Mode=OneWay}" Foreground="White"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </UniformGrid>

                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" Orientation="Horizontal">
                                <Border CornerRadius="7" Background="#C0000000" Padding="10,5" Margin="4,0"
                                        Visibility="{Binding DetailOrigState, Converter={StaticResource BoolVis}}">
                                    <TextBlock FontSize="12" Foreground="{StaticResource WarnBrush}"><Run Text="원본: "/><Run Text="{Binding DetailOrigState, Mode=OneWay}"/></TextBlock>
                                </Border>
                                <Border CornerRadius="7" Background="#C0000000" Padding="10,5" Margin="4,0"
                                        Visibility="{Binding DetailHecsState, Converter={StaticResource BoolVis}}">
                                    <TextBlock FontSize="12" Foreground="{StaticResource WarnBrush}"><Run Text="{b:Brand 'HECS: '}"/><Run Text="{Binding DetailHecsState, Mode=OneWay}"/></TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 하단 추이 그래프 -->
                        <Border Grid.Row="1" Margin="0,16,20,0" CornerRadius="14" Background="{StaticResource Surface2Brush}" Padding="12,10,16,8">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="52,0,0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource OrigBrush}" Margin="0,0,5,0"/>
                                        <TextBlock Text="원본" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,12,0"/>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource HecsBrush}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{b:Brand 'HECS'}" Style="{StaticResource Caption}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="11.5">
                                        <Run Text="비트레이트 추이 · "/><Run Text="{Binding HistoryLabel, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                                <c:DualSeriesChart ShowAxis="True" Capacity="{Binding HistoryCapacity}"
                                                   SeriesA="{Binding SelectedChannel.OrigHistory}" SeriesB="{Binding SelectedChannel.HecsHistory}"
                                                   Version="{Binding SelectedChannel.HistoryVersion}"
                                                   BrushA="{StaticResource OrigBrush}" BrushB="{StaticResource HecsBrush}"/>
                            </DockPanel>
                        </Border>

                        <!-- 우측 통계 -->
                        <ScrollViewer Grid.Column="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedChannel}">
                                <Border CornerRadius="16" Background="{StaticResource Surface2Brush}" Padding="20,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="실시간 압축률" Style="{StaticResource Caption}"/>
                                            <TextBlock Style="{StaticResource Num}" Foreground="{StaticResource HecsBrush}">
                                                <Run Text="{Binding RatioText, Mode=OneWay}" FontSize="46" FontWeight="SemiBold"/><Run Text=" : 1" FontSize="20"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5">
                                                <Run Text="평균 "/><Run Text="{Binding AvgRatioText, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                                <Run Text="  최소 "/><Run Text="{Binding MinRatioText, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                                <Run Text="  최대 "/><Run Text="{Binding MaxRatioText, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="92" Height="92">
                                            <c:RingGauge Value="{Binding SavingFraction}" Thickness="8" ValueBrush="{StaticResource SaveGrad}"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Num}" FontWeight="SemiBold">
                                                    <Run Text="{Binding SavingPreciseText, Mode=OneWay}" FontSize="19"/><Run Text="%" FontSize="11"/>
                                                </TextBlock>
                                                <TextBlock Text="대역폭 절감" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="16" Background="{StaticResource Surface2Brush}" Padding="20,14" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="1" Text="원본" Style="{StaticResource StatValue}" Foreground="{StaticResource OrigBrush}" FontFamily="{StaticResource UiFont}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{b:Brand 'HECS'}" Style="{StaticResource StatValue}" Foreground="{StaticResource HecsBrush}" FontFamily="{StaticResource UiFont}" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="1" Text="코덱" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OrigCodecText}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HecsCodecText}" Style="{StaticResource StatValue}"/>

                                        <TextBlock Grid.Row="2" Text="해상도" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrigResText}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding HecsResText}" Style="{StaticResource StatValue}"/>

                                        <TextBlock Grid.Row="3" Text="프레임레이트" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OrigFpsText}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding HecsFpsText}" Style="{StaticResource StatValue}"/>

                                        <TextBlock Grid.Row="4" Text="GOP (프레임)" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OrigGopText}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding HecsGopText}" Style="{StaticResource StatValue}"/>

                                        <TextBlock Grid.Row="5" Text="현재 비트레이트" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding OrigRateText}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding HecsRateText}" Style="{StaticResource StatValue}"/>

                                        <TextBlock Grid.Row="6" Text="평균 비트레이트" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OrigAvgText}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding HecsAvgText}" Style="{StaticResource StatValue}"/>

                                        <TextBlock Grid.Row="7" Text="누적 수신량" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding OrigTotalText}" Style="{StaticResource StatValue}"/>
                                        <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding HecsTotalText}" Style="{StaticResource StatValue}"/>
                                    </Grid>
                                </Border>

                                <!-- 평균 비트레이트 -->
                                <Border CornerRadius="16" Background="#1222D3EE" BorderBrush="#3322D3EE" BorderThickness="1" Padding="20,14" Margin="0,12,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"
                                                       ToolTip="{b:Brand '원본과 HECS가 모두 수신 중이던 시간 기준'}">
                                                <Run Text="측정 "/><Run Text="{Binding MeasuredDurationText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="평균 비트레이트" Style="{StaticResource Caption}"/>
                                        </DockPanel>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource OrigBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="원본" FontSize="11.5" Foreground="{StaticResource OrigBrush}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Num}">
                                                    <Run Text="{Binding OrigAvgValue, Mode=OneWay}" FontSize="26"/><Run Text=" "/><Run Text="{Binding OrigAvgUnit, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="13" Margin="10,14,10,0"
                                                       Foreground="{StaticResource FaintBrush}"/>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource HecsBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{b:Brand 'HECS'}" FontSize="11.5" Foreground="{StaticResource HecsBrush}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Num}" Foreground="{StaticResource HecsBrush}">
                                                    <Run Text="{Binding HecsAvgValue, Mode=OneWay}" FontSize="26"/><Run Text=" "/><Run Text="{Binding HecsAvgUnit, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <!-- 원본 대비 HECS 평균 비율 막대 -->
                                        <Border Height="5" CornerRadius="3" Background="{StaticResource OrigBrush}" Opacity="0.9" Margin="0,10,0,0">
                                            <Border CornerRadius="3" Background="{StaticResource HecsBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding HecsAvgFraction}"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                        <TextBlock FontSize="11.5" Margin="0,8,0,0" Foreground="{StaticResource SubTextBrush}">
                                            <Run Text="평균 압축률 "/><Run Text="{Binding AvgRatioText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/><Run Text=":1  ·  평균 절감 "/><Run
                                                 Text="{Binding AvgSavingText, Mode=OneWay}" Foreground="{StaticResource SaveBrush}" FontWeight="SemiBold"/><Run Text="%"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="16" Background="#1234D399" BorderBrush="#3334D399" BorderThickness="1" Padding="20,14" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="이 채널에서 절약한 데이터" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding SavedText}" Style="{StaticResource Num}" FontSize="30" Foreground="{StaticResource SaveBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="16" Background="{StaticResource Surface2Brush}" Padding="20,14" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="스트림 연결" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}">
                                            <Run Text="원본 · " Foreground="{StaticResource OrigBrush}"/><Run Text="{Binding OrigMessage, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding OrigUrlMasked}" FontSize="11" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,10"/>
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}">
                                            <Run Text="{b:Brand 'HECS · '}" Foreground="{StaticResource HecsBrush}"/><Run Text="{Binding HecsMessage, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding HecsUrlMasked}" FontSize="11" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 중앙 모달 (설정 저장 결과 등) -->
        <Grid Grid.ColumnSpan="2" Background="#B3040609" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolVis}}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20"
                    Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineHoverBrush}" BorderThickness="1" Padding="32,30,32,26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Width="64" Height="64" HorizontalAlignment="Center">
                        <Ellipse Fill="{Binding DialogKind, Converter={StaticResource KindBrush}}" Opacity="0.16"/>
                        <Ellipse Margin="10" Fill="{Binding DialogKind, Converter={StaticResource KindBrush}}"/>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"
                                   Visibility="{Binding DialogKind, Converter={StaticResource Eq}, ConverterParameter=Ok}"/>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center"
                                   Visibility="{Binding DialogKind, Converter={StaticResource Eq}, ConverterParameter=Alarm}"/>
                    </Grid>
                    <TextBlock Text="{Binding DialogTitle}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,8"/>
                    <TextBlock Text="{Binding DialogMessage}" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap" LineHeight="20" HorizontalAlignment="Center"/>
                    <Button x:Name="DialogOk" Style="{StaticResource PrimaryButton}" Content="확인" Margin="0,24,0,0" Padding="16,10"
                            IsDefault="True" Command="{Binding CloseDialogCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 토스트 -->
        <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                CornerRadius="12" Background="#F01D2734" BorderBrush="{StaticResource LineHoverBrush}" BorderThickness="1" Padding="18,10"
                Visibility="{Binding HasToast, Converter={StaticResource BoolVis}}" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource SaveBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Toast}" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
