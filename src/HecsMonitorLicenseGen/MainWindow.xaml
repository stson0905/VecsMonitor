<Window x:Class="HecsMonitorLicenseGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:HecsMonitor.Converters;assembly=HecsMonitor"
        Title="{b:Brand 'HECS License Studio'}" Width="1400" Height="880" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>

        <!-- 단계 번호 -->
        <Style x:Key="StepNo" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#1A22D3EE"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepNoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource HecsBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SmallGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 인증서 항목 -->
        <Style x:Key="CertLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="CertValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- ===== 타이틀 바 ===== -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Height="56" Content="&#xE921;" Click="OnMinimize"/>
                <Button Style="{StaticResource CaptionButton}" Height="56" x:Name="MaxButton" Content="&#xE922;" Click="OnMaximize"/>
                <Button Style="{StaticResource CloseCaptionButton}" Height="56" Content="&#xE8BB;" Click="OnClose"/>
            </StackPanel>

            <!-- 서명 키 상태 -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Border CornerRadius="10" Padding="12,6" Margin="0,0,8,0" ToolTip="{Binding KeyDetail}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1AF43F5E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding KeyState}" Value="ok">
                                    <Setter Property="Background" Value="#1A34D399"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding KeyState}" Value="mismatch">
                                    <Setter Property="Background" Value="#1AFBBF24"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="13" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE72E;"/>
                                    <Setter Property="Foreground" Value="{StaticResource AlarmBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KeyState}" Value="ok">
                                            <Setter Property="Text" Value="&#xE8D7;"/>
                                            <Setter Property="Foreground" Value="{StaticResource SaveBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KeyState}" Value="mismatch">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <TextBlock Text="{Binding KeyStatusText}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding KeyDetail}" FontSize="10.5" Foreground="{StaticResource SubTextBrush}" MaxWidth="330" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button AutomationProperties.AutomationId="Settings" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="16" ToolTip="설정 (저장 폴더 · 서명 키 · 버전)"
                        Command="{Binding OpenSettingsCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Image Source="pack://application:,,,/HecsMonitor;component/Assets/HecsMonitor.png" Width="30" Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                <TextBlock Text="{b:Brand 'HECS'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HecsBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" License Studio" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Margin="12,0,0,0" CornerRadius="6" Background="#14FFFFFF" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="발급 · 이력 · 검사" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"/>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ===== 본문 ===== -->
        <Grid Grid.Row="1" Margin="20,4,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 1. 발급 정보 ===== -->
            <Border Style="{StaticResource Panel}">
                <DockPanel Margin="22,20,22,20">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="양식 비우기"
                                Command="{Binding NewFormCommand}"/>
                        <TextBlock Text="발급 정보" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 발급 버튼 -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button AutomationProperties.AutomationId="Issue" Style="{StaticResource PrimaryButton}" Padding="16,13" Command="{Binding IssueCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="라이선스 발급" FontSize="14.5"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding IssueHint}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,10"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                    Content="&#xE838;" ToolTip="저장 폴더 열기 (바꾸기는 설정에서)" Command="{Binding OpenOutputCommand}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OutputRoot}">
                                <Run Text="저장 폴더  "/><Run Text="{Binding OutputRoot, Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,12" Padding="0,0,10,0">
                        <StackPanel>
                            <!-- ① 사용자 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StepNo}"><TextBlock Text="1" Style="{StaticResource StepNoText}"/></Border>
                                <TextBlock Text="사용자 (고객 · 현장)" Style="{StaticResource StepTitle}"/>
                            </StackPanel>
                            <TextBox AutomationProperties.AutomationId="Licensee" Text="{Binding Licensee, UpdateSourceTrigger=PropertyChanged}" Tag="예: OO시청 관제센터" Margin="0,0,0,20"/>

                            <!-- ② 장치 ID -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StepNo}"><TextBlock Text="2" Style="{StaticResource StepNoText}"/></Border>
                                <TextBlock Text="장치 ID (MAC)" Style="{StaticResource StepTitle}"/>
                            </StackPanel>
                            <Grid>
                                <TextBox Text="{Binding MachineInput, UpdateSourceTrigger=PropertyChanged}" Tag="00-1A-2B-3C-4D-5E"
                                         FontFamily="{StaticResource NumFont}" FontSize="15" Padding="11,9,36,9"/>
                                <TextBlock HorizontalAlignment="Right" Margin="0,0,12,0" FontSize="14" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MachineState}" Value="ok">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SaveBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MachineState}" Value="bad">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Text" Value="&#xE783;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AlarmBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <DockPanel Margin="0,8,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource SmallGhost}" Command="{Binding PasteIdCommand}" Margin="0,0,6,0"
                                            ToolTip="{b:Brand 'HECS Monitor 안내 창에서 복사된 장치 ID 붙여 넣기'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="붙여넣기"/>
                                        </StackPanel>
                                    </Button>
                                    <Button AutomationProperties.AutomationId="UseThisPc" Style="{StaticResource SmallGhost}" Command="{Binding UseThisPcCommand}" Content="이 PC"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MachinePreview}" FontFamily="{StaticResource NumFont}" FontSize="12"
                                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}"
                                       Text="{b:Brand '설치 PC에서 HECS Monitor를 실행하면 안내 창에 표시되고 클립보드에 복사됩니다.'}"/>
                            <Border Height="16"/>

                            <!-- ③ 채널 수 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StepNo}"><TextBlock Text="3" Style="{StaticResource StepNoText}"/></Border>
                                <TextBlock Text="허가 채널 수" Style="{StaticResource StepTitle}"/>
                            </StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBox DockPanel.Dock="Right" Width="76" Text="{Binding Channels, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource NumFont}" FontSize="15" TextAlignment="Center" Margin="8,0,0,0"/>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                                    <UniformGrid Columns="5">
                                        <RadioButton Style="{StaticResource Segment}" Padding="0,6" Content="4" GroupName="ch"
                                                     IsChecked="{Binding Channels, Converter={StaticResource Eq}, ConverterParameter=4}"/>
                                        <RadioButton Style="{StaticResource Segment}" Padding="0,6" Content="8" GroupName="ch"
                                                     IsChecked="{Binding Channels, Converter={StaticResource Eq}, ConverterParameter=8}"/>
                                        <RadioButton Style="{StaticResource Segment}" Padding="0,6" Content="16" GroupName="ch"
                                                     IsChecked="{Binding Channels, Converter={StaticResource Eq}, ConverterParameter=16}"/>
                                        <RadioButton Style="{StaticResource Segment}" Padding="0,6" Content="32" GroupName="ch"
                                                     IsChecked="{Binding Channels, Converter={StaticResource Eq}, ConverterParameter=32}"/>
                                        <RadioButton Style="{StaticResource Segment}" Padding="0,6" Content="64" GroupName="ch"
                                                     IsChecked="{Binding Channels, Converter={StaticResource Eq}, ConverterParameter=64}"/>
                                    </UniformGrid>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding ChannelsNote}" FontSize="11" Foreground="{StaticResource WarnBrush}" Margin="0,2,0,0"
                                       Visibility="{Binding ChannelsNote, Converter={StaticResource BoolVis}}"/>
                            <Border Height="18"/>

                            <!-- ④ 생성일 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StepNo}"><TextBlock Text="4" Style="{StaticResource StepNoText}"/></Border>
                                <TextBlock Text="생성일" Style="{StaticResource StepTitle}"/>
                            </StackPanel>
                            <DockPanel Margin="0,0,0,20">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhost}" Content="오늘" Margin="8,0,0,0" Command="{Binding TodayCommand}"/>
                                <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Tag="yyyy-MM-dd" FontFamily="{StaticResource NumFont}"/>
                            </DockPanel>

                            <!-- ⑤ 메모 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StepNo}"><TextBlock Text="5" Style="{StaticResource StepNoText}"/></Border>
                                <TextBlock Text="메모" Style="{StaticResource StepTitle}"/>
                                <TextBlock Text="  발급 이력에만 저장" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox AutomationProperties.AutomationId="Memo" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" Tag="계약 번호, 담당자 등"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== 2. 인증서 미리보기 ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="라이선스 인증서 미리보기" Style="{StaticResource Overline}" Margin="6,8,0,10"/>

                <StackPanel Grid.Row="1" MaxWidth="620" VerticalAlignment="Top">
                    <!-- 인증서 카드 (그라데이션 테두리) -->
                    <Border CornerRadius="24" Padding="1.5" Background="{StaticResource AccentGrad}">
                        <Border CornerRadius="23" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Border CornerRadius="23" Background="{StaticResource HeroGlow}"/>
                                <StackPanel Margin="32,28,32,24">
                                    <DockPanel>
                                        <Image DockPanel.Dock="Right" Source="pack://application:,,,/HecsMonitor;component/Assets/HecsMonitor.png"
                                               Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.9"/>
                                        <StackPanel>
                                            <TextBlock Text="SOFTWARE LICENSE CERTIFICATE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource HecsBrush}"/>
                                            <TextBlock Text="{b:Brand 'HECS Live Compression Monitor'}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- 채널 수 + 서명 인장 -->
                                    <Grid Margin="0,26,0,22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="허가 채널" Style="{StaticResource CertLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Channels}" FontFamily="{StaticResource NumFont}" FontSize="76" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SaveGrad}" LineHeight="80" LineStackingStrategy="BlockLineHeight"/>
                                                <TextBlock Text="CH" FontFamily="{StaticResource NumFont}" FontSize="22" Foreground="{StaticResource SubTextBrush}"
                                                           VerticalAlignment="Bottom" Margin="8,0,0,12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Border Width="132" Height="132" CornerRadius="18" Background="#0CFFFFFF" Padding="10"
                                                    ToolTip="서명 인장: 발급 전에는 입력값, 발급 후에는 실제 ECDSA 서명으로 만들어지는 고유 무늬">
                                                <ItemsControl ItemsSource="{Binding Seal}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="7" Rows="7"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Rectangle Fill="{Binding}" Margin="1.5" RadiusX="3" RadiusY="3"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <TextBlock Text="SIGNATURE SEAL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource FaintBrush}"
                                                       HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,16,16">
                                            <TextBlock Text="사용자" Style="{StaticResource CertLabel}"/>
                                            <TextBlock Text="{Binding PreviewLicensee}" Style="{StaticResource CertValue}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="장치 ID" Style="{StaticResource CertLabel}"/>
                                            <TextBlock Text="{Binding MachinePreview}" Style="{StaticResource CertValue}" FontFamily="{StaticResource NumFont}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="생성일" Style="{StaticResource CertLabel}"/>
                                            <TextBlock Text="{Binding PreviewDate}" Style="{StaticResource CertValue}" FontFamily="{StaticResource NumFont}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="라이선스 ID" Style="{StaticResource CertLabel}"/>
                                            <TextBlock Text="{Binding PreviewLicenseId}" Style="{StaticResource CertValue}" FontFamily="{StaticResource NumFont}"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <!-- 절취선 -->
                                    <Grid Margin="-33,22,-33,16">
                                        <Line X1="0" X2="2000" Stroke="#2A3646" StrokeThickness="1.5" StrokeDashArray="4 4" VerticalAlignment="Center" Margin="14,0"/>
                                        <Ellipse Width="20" Height="20" Fill="{StaticResource BgBrush}" HorizontalAlignment="Left" Margin="-10,0,0,0"/>
                                        <Ellipse Width="20" Height="20" Fill="{StaticResource BgBrush}" HorizontalAlignment="Right" Margin="0,0,-10,0"/>
                                    </Grid>

                                    <DockPanel Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}">
                                        <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource NumFont}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                                                   ToolTip="{b:Brand 'HECS Monitor에 들어 있는 공개키의 지문'}">
                                            <Run Text="KEY "/><Run Text="{Binding AppFingerprint, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="ECDSA P-256 · SHA-256 서명  ·  AES-256-GCM 봉인" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                                    </DockPanel>
                                    <TextBlock Text="{b:Brand 'HECS Monitor 정품 라이선스 · 발급된 장치에서만 사용할 수 있습니다'}" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                               Visibility="{Binding DeveloperMode, Converter={StaticResource InvBoolVis}}"/>
                                </StackPanel>

                                <!-- 발급 도장 -->
                                <Border x:Name="Stamp" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,100,205,0"
                                        BorderBrush="{StaticResource SaveBrush}" BorderThickness="3" CornerRadius="10" Padding="16,6"
                                        RenderTransformOrigin="0.5,0.5" Opacity="0" IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="StampScale" ScaleX="1" ScaleY="1"/>
                                            <RotateTransform Angle="-14"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Text="ISSUED" FontFamily="{StaticResource NumFont}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource SaveBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding PreviewDate}" FontFamily="{StaticResource NumFont}" FontSize="11"
                                                   Foreground="{StaticResource SaveBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- 발급 결과 -->
                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="20,16"
                            Visibility="{Binding IsIssued, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource SmallGhost}" Content="폴더 열기" Margin="0,0,6,0" Command="{Binding OpenFolderCommand}"/>
                                    <Button Style="{StaticResource SmallGhost}" Content="다른 위치에 저장" Command="{Binding SaveAsCommand}"/>
                                </StackPanel>
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource SaveBrush}" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="license.key 저장 완료 · 자체 검증 통과" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding LastIssued.FilePath}" FontSize="11" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding LastIssued.FilePath}"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="텍스트 편집기에서 보이는 내용 — 채널 수·날짜·장치 정보가 드러나지 않습니다" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                                <Border Background="{StaticResource FieldBrush}" CornerRadius="10" Padding="12,10" MaxHeight="120">
                                    <TextBlock Text="{Binding LastIssued.LicenseText}" FontFamily="Consolas" FontSize="11.5"
                                               Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== 3. 발급 이력 / 키 검사 ===== -->
            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <DockPanel Margin="18,18,18,16">
                    <Border DockPanel.Dock="Top" Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                        <UniformGrid Columns="2">
                            <RadioButton Style="{StaticResource Segment}" GroupName="tab"
                                         IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=ledger}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="발급 이력"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Segment}" GroupName="tab"
                                         IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=inspect}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="키 검사"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <!-- 발급 이력 -->
                    <DockPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=ledger}">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="사용자 · 장치 ID · 라이선스 ID · 메모 검색" Padding="32,8,10,8"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding LedgerSummary}" Style="{StaticResource Caption}" FontSize="11.5" Margin="4,0,0,10"/>
                        <Grid>
                            <ListBox ItemsSource="{Binding EntriesView}" ItemContainerStyle="{StaticResource CardListItem}" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="7" Background="#1A22D3EE" Padding="8,2" VerticalAlignment="Top">
                                                    <TextBlock FontFamily="{StaticResource NumFont}" FontSize="12" Foreground="{StaticResource HecsBrush}" FontWeight="SemiBold">
                                                        <Run Text="{Binding Channels, Mode=OneWay}"/><Run Text=" CH"/>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" FontFamily="{StaticResource NumFont}">
                                                <Run Text="{Binding MachineText, Mode=OneWay}"/><Run Text="   ·   "/><Run Text="{Binding DateText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding LicenseId}" FontSize="10.5" Foreground="{StaticResource FaintBrush}" FontFamily="{StaticResource NumFont}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Memo}" FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Memo, Converter={StaticResource BoolVis}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="-6,6,0,-4">
                                                <Button Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="12" Content="&#xE8EE;" ToolTip="같은 조건으로 재발급 (양식에 불러오기)"
                                                        Command="{Binding DataContext.ReuseCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="12" Content="&#xE838;" ToolTip="저장 폴더 열기"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="12" Content="&#xE74E;" ToolTip="license.key 다시 저장"
                                                        Command="{Binding DataContext.SaveAsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="12" Content="&#xE8C8;" ToolTip="장치 ID 복사"
                                                        Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding MachineText}"/>
                                                <Button Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="12" Content="&#xE74D;" ToolTip="이력에서 지우기"
                                                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="아직 발급한 라이선스가 없습니다" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Entries.Count, Converter={StaticResource InvBoolVis}}"/>
                        </Grid>
                    </DockPanel>

                    <!-- 키 검사 -->
                    <StackPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=inspect}">
                        <Grid Height="150" Margin="0,0,0,14">
                            <Rectangle RadiusX="16" RadiusY="16" Stroke="#3A4A5E" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#06FFFFFF"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource HecsBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="license.key를 이 창에 끌어 놓으세요" FontWeight="SemiBold" Margin="0,10,0,4" HorizontalAlignment="Center"/>
                                <Button Style="{StaticResource SmallGhost}" Content="파일 찾아보기" HorizontalAlignment="Center" Margin="0,6,0,0"
                                        Command="{Binding InspectBrowseCommand}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="2,0,2,14"
                                   Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}"
                                   Text="키 파일은 장치 ID로 암호화되어 있어, 입력란의 장치 ID · 발급 이력 · 이 PC의 장치 ID로 열어 서명을 확인합니다."/>

                        <Border CornerRadius="14" Padding="16,14" BorderThickness="1"
                                Visibility="{Binding InspectResult, Converter={StaticResource BoolVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#10F43F5E"/>
                                    <Setter Property="BorderBrush" Value="#55F43F5E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InspectResult.Ok}" Value="True">
                                            <Setter Property="Background" Value="#1034D399"/>
                                            <Setter Property="BorderBrush" Value="#5534D399"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding InspectResult.FileName}" Style="{StaticResource Overline}"/>
                                <TextBlock Text="{Binding InspectResult.Status}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <Grid Margin="0,12,0,0" Visibility="{Binding InspectResult.Ok, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="사용자" Style="{StaticResource Caption}" Margin="0,3"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InspectResult.Licensee}" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Text="허가 채널" Style="{StaticResource Caption}" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InspectResult.ChannelsText}" Margin="0,3" Foreground="{StaticResource HecsBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Text="생성일" Style="{StaticResource Caption}" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InspectResult.DateText}" Margin="0,3" FontFamily="{StaticResource NumFont}"/>
                                    <TextBlock Grid.Row="3" Text="장치 ID" Style="{StaticResource Caption}" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InspectResult.MachineText}" Margin="0,3" FontFamily="{StaticResource NumFont}"/>
                                    <TextBlock Grid.Row="4" Text="라이선스 ID" Style="{StaticResource Caption}" Margin="0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InspectResult.LicenseId}" Margin="0,3" FontFamily="{StaticResource NumFont}"/>
                                </Grid>
                                <StackPanel Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="파일 원문 (텍스트 편집기에서 보이는 내용)" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                                    <Border Background="{StaticResource FieldBrush}" CornerRadius="9" Padding="10,8">
                                        <TextBlock Text="{Binding InspectResult.RawText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 설정 (오른쪽 서랍) ===== -->
        <Grid Grid.RowSpan="2" WindowChrome.IsHitTestVisibleInChrome="True"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVis}}">
            <Border Background="#99000000" MouseLeftButtonDown="OnSettingsBackdrop"/>
            <Border Width="580" HorizontalAlignment="Right" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="28,22,18,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="12" ToolTip="닫기 (Esc)"
                                Command="{Binding CloseSettingsCommand}"/>
                        <TextBlock Text="설정" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Margin="12,0,0,0" CornerRadius="6" Background="#22FBBF24" Padding="8,2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="개발자 모드" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                        </Border>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,8,28,28">

                            <!-- 저장 폴더 -->
                            <TextBlock Text="키 저장 폴더" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="발급한 license.key는 이 폴더 아래 '날짜_사용자_장치ID' 폴더에 저장됩니다."/>
                            <TextBox Text="{Binding OutputRoot, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                                <Button Style="{StaticResource SmallGhost}" Content="폴더 바꾸기" Margin="0,0,6,0" Command="{Binding ChangeOutputCommand}"/>
                                <Button Style="{StaticResource SmallGhost}" Content="폴더 열기" Margin="0,0,6,0" Command="{Binding OpenOutputCommand}"/>
                                <Button Style="{StaticResource SmallGhost}" Content="기본값으로" Command="{Binding ResetOutputCommand}"/>
                            </StackPanel>

                            <!-- 서명 키 -->
                            <TextBlock Text="서명 키" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border CornerRadius="12" Padding="14,12" Margin="0,0,0,10" Background="{StaticResource Surface2Brush}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhost}" Content="개인키 불러오기" VerticalAlignment="Center"
                                            Command="{Binding LoadKeyCommand}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KeyStatusText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding KeyDetail}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,2,8,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- 개발자 모드: 서명 키 상세 -->
                            <Border CornerRadius="12" Padding="16,14" Margin="0,0,0,10" Background="{StaticResource FieldBrush}"
                                    BorderBrush="#33FBBF24" BorderThickness="1"
                                    Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="개인키 파일" Style="{StaticResource Caption}" Margin="0,4"/>
                                        <TextBlock Grid.Column="1" Text="{Binding KeyPathText}" TextWrapping="Wrap" FontSize="12" Margin="0,4"/>
                                        <TextBlock Grid.Row="1" Text="개인키 보호" Style="{StaticResource Caption}" Margin="0,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KeyProtectionText}" FontSize="12" Margin="0,4"/>
                                        <TextBlock Grid.Row="2" Text="개인키 지문" Style="{StaticResource Caption}" Margin="0,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding KeyFingerprintText}" FontFamily="{StaticResource NumFont}" Margin="0,4"/>
                                        <TextBlock Grid.Row="3" Text="앱 공개키 지문" Style="{StaticResource Caption}" Margin="0,4"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AppFingerprint}" FontFamily="{StaticResource NumFont}" Margin="0,4"/>
                                    </Grid>
                                    <TextBlock Text="{b:Brand 'HECS Monitor에 들어 있는 공개키 (SoftwareLicenseCore.PublicKeyBase64)'}" Style="{StaticResource Overline}" Margin="0,12,0,6"/>
                                    <TextBox Text="{Binding AppPublicKey, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5"/>
                                    <TextBlock Text="불러온 개인키의 공개키" Style="{StaticResource Overline}" Margin="0,12,0,6"/>
                                    <TextBox Text="{Binding LoadedPublicKey, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5"/>
                                    <DockPanel Margin="0,14,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhost}" Content="새 서명 키 쌍 만들기" Command="{Binding CreateKeyCommand}"/>
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource WarnBrush}"
                                                   Text="{b:Brand '키를 교체하면 HECS Monitor를 다시 빌드·배포해야 하고, 이전에 발급한 라이선스는 모두 무효가 됩니다.'}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Height="18"/>

                            <!-- 프로그램 정보 -->
                            <TextBlock Text="프로그램 정보" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border CornerRadius="12" Padding="16,14" Background="{StaticResource Surface2Brush}" Margin="0,0,0,28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="프로그램" Style="{StaticResource Caption}" Margin="0,5"/>
                                    <TextBlock Grid.Column="1" Text="{b:Brand 'HECS License Studio (HecsMonitorLicenseGen)'}" Margin="0,5"/>
                                    <TextBlock Grid.Row="1" Text="버전" Style="{StaticResource Caption}" Margin="0,5"/>
                                    <!-- 5번 연속 클릭 → 개발자 모드 전환 (숨은 기능이라 커서·툴팁 없음) -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="Transparent" HorizontalAlignment="Left" Margin="0,5"
                                            MouseLeftButtonUp="OnVersionClick">
                                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Num}" FontSize="15"/>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="런타임" Style="{StaticResource Caption}" Margin="0,5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeText}" Margin="0,5"/>
                                    <TextBlock Grid.Row="3" Text="데이터 폴더" Style="{StaticResource Caption}" Margin="0,5" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,3">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE838;"
                                                ToolTip="열기 (설정 · 발급 이력)" Command="{Binding OpenDataFolderCommand}"/>
                                        <TextBlock Text="{Binding DataFolder}" FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- 개발자 모드: 제품 이름 (고른 값은 개발자 모드를 꺼도 유지) -->
                            <StackPanel Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}" Margin="0,0,0,28">
                                <TextBlock Text="제품 이름" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="화면과 인증서에 표시할 제품 이름입니다. 고르는 즉시 저장되며 개발자 모드를 꺼도 유지됩니다."/>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="HECS" GroupName="brand"
                                                     IsChecked="{Binding BrandName, Converter={StaticResource Eq}, ConverterParameter=HECS}"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="ECO" GroupName="brand"
                                                     IsChecked="{Binding BrandName, Converter={StaticResource Eq}, ConverterParameter=ECO}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 개발자 모드: 기능 상세 설명 -->
                            <StackPanel Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="기능 상세 설명" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20">
                                    <Run Foreground="{StaticResource TextBrush}" Text="발급 순서"/><LineBreak/>
                                    1. 내용(채널 수 · 생성일 · 장치 ID · 사용자 · 라이선스 ID)을 만든다.<LineBreak/>
                                    2. 서명 개인키로 ECDSA P-256(SHA-256) 서명한다.<LineBreak/>
                                    3. 내용과 서명을 장치 ID에서 만든 키로 AES-256-GCM 암호화해 Base64로 저장한다.<LineBreak/>
                                    <Run Text="{b:Brand '4. HECS Monitor와 같은 코드로 다시 열어 자체 검증한 뒤 license.key로 저장하고 발급 이력에 남긴다.'}"/><LineBreak/><LineBreak/>
                                    <Run Foreground="{StaticResource TextBrush}" Text="{b:Brand 'HECS Monitor 쪽 검증'}"/><LineBreak/>
                                    • 프로그램 폴더의 lic\license.key를 이 PC의 모든 유선 MAC으로 열어 보고, 공개키로 서명을 확인한다.<LineBreak/>
                                    • 감시·등록 가능 채널 = 허가 채널 수와 64 중 작은 값. 키가 없거나 맞지 않으면 실행하지 않는다.<LineBreak/><LineBreak/>
                                    <Run Foreground="{StaticResource TextBrush}" Text="화면 요소"/><LineBreak/>
                                    • 서명 인장: 발급 전에는 입력값, 발급 후에는 실제 서명의 SHA-256으로 그리는 7×7 대칭 무늬.<LineBreak/>
                                    • 키 검사: 입력 중인 장치 ID → 발급 이력 → 이 PC 순서로 파일을 열어 내용과 서명을 확인한다.<LineBreak/><LineBreak/>
                                    <Run Foreground="{StaticResource TextBrush}" Text="보안 주의"/><LineBreak/>
                                    • 개인키가 있으면 누구나 라이선스를 만들 수 있으므로 외부에 공유하지 말고 백업해 둔다.<LineBreak/>
                                    • 설정 파일: 데이터 폴더의 config.json · 발급 이력: ledger.json
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 비밀번호 ===== -->
        <Grid Grid.RowSpan="2" Background="#B3000000" Visibility="{Binding IsPasswordOpen, Converter={StaticResource BoolVis}}">
            <Border Width="440" Style="{StaticResource Panel}" Background="{StaticResource Surface2Brush}" Padding="26,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource HecsBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding PasswordTitle}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PasswordDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="비밀번호" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="Pw1" Margin="0,0,0,12" KeyDown="OnPasswordKey"/>
                    <StackPanel Visibility="{Binding PasswordMode, Converter={StaticResource Eq}, ConverterParameter=create}">
                        <TextBlock Text="비밀번호 확인" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="Pw2" Margin="0,0,0,12" KeyDown="OnPasswordKey"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PasswordError}" Foreground="{StaticResource AlarmBrush}" FontSize="12" Margin="0,0,0,10"
                               Visibility="{Binding PasswordError, Converter={StaticResource BoolVis}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="취소" Margin="0,0,8,0" Command="{Binding CancelPasswordCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="확인" Click="OnPasswordOk"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 새 키 쌍 안내 ===== -->
        <Grid Grid.RowSpan="2" Background="#B3000000" Visibility="{Binding HasNewPublicKey, Converter={StaticResource BoolVis}}">
            <Border Width="620" Style="{StaticResource Panel}" Background="{StaticResource Surface2Brush}" Padding="26,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="새 서명 키를 만들었습니다" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,14">
                        이 키로 발급하려면 아래 공개키를 HecsMonitor의 <Run Text="lic\SoftwareLicenseCore.cs" Foreground="{StaticResource TextBrush}"/> 에 있는
                        <Run Text="PublicKeyBase64" Foreground="{StaticResource TextBrush}"/> 값으로 바꾸고 다시 빌드·배포해야 합니다.
                        바꾸면 이전 키로 발급한 라이선스는 모두 무효가 됩니다. 개인키 파일은 안전한 곳에 백업하세요.
                    </TextBlock>
                    <TextBox Text="{Binding NewPublicKey, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="공개키 복사" Margin="0,0,8,0"
                                Command="{Binding CopyTextCommand}" CommandParameter="{Binding NewPublicKey}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="확인" Command="{Binding CloseNewKeyCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 알림 ===== -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34" CornerRadius="12" Padding="18,10"
                Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource LineHoverBrush}" BorderThickness="1"
                Visibility="{Binding HasToast, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding Toast}" FontSize="13"/>
        </Border>
    </Grid>
</Window>
